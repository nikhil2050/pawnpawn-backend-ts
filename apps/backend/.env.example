# ============================================================================
# PawnPawn Backend — Environment Variables (.env.example)
# ============================================================================
#
# COPY THIS FILE: cp .env.example .env
# Then edit .env with your local values.
#
# NEVER commit .env to version control (it's in .gitignore).
# This .env.example is safe to commit because it contains placeholder values.
#
# ============================================================================
# JAVA DEVELOPER NOTES:
#   - This file is like Spring Boot's application.properties or application.yml (src/main/resources/application.properties).
#   - Format: KEY=VALUE (no quotes needed, but you can use quotes for values with special characters).
#   - Lines starting with # are comments.
#   - process.env.KEY in TypeScript reads these (like System.getenv("KEY")).
#   - Medusa's loadEnv() reads this file automatically on startup.
# ============================================================================

# ===========================================
# DATABASE CONFIGURATION
# ===========================================
# PostgreSQL connection string for local development.
# Format: postgres://username:password@host:port/database
#
# JAVA EQUIVALENT (Spring Boot application.properties):
#   spring.datasource.url=jdbc:postgresql://localhost:5432/pawnpawn_db
#   spring.datasource.username=postgres
#   spring.datasource.password=postgres
#
# In Medusa/TypeScript, this is a single URL string:
DATABASE_URL=postgres://postgres:postgres@localhost:5432/pawnpawn_db

# Optional: Database name (used by some Medusa commands)
# JAVA EQUIVALENT: spring.datasource.name or just the database in the URL
DB_NAME=pawnpawn_db

# ===========================================
# CORS CONFIGURATION
# ===========================================
# Cross-Origin Resource Sharing — controls which frontend apps can call
# the Medusa backend API. Without this, browsers block cross-origin requests.
#
# JAVA EQUIVALENT (Spring Security):
#   @CrossOrigin(origins = {"http://localhost:3000", "http://localhost:3001"})
#   or in application.properties:
#   spring.mvc.cors.allowed-origins=http://localhost:3000,http://localhost:3001
#
# Buyer App (Next.js storefront) — port 3000
# Seller App (Next.js seller dashboard) — port 3001
# Both need credentials: true for HTTP-only cookies (auth sessions)
STORE_CORS=http://localhost:3000,http://localhost:3001

# Admin Dashboard — Medusa Admin (port 9000) or Vite dev (port 5173)
ADMIN_CORS=http://localhost:9000,http://localhost:5173

# Auth endpoints — includes both storefronts + admin for login/logout
AUTH_CORS=http://localhost:3000,http://localhost:3001,http://localhost:9000

# ===========================================
# AUTHENTICATION & SECURITY
# ===========================================
# JWT Secret — Secret key for signing JSON Web Tokens (authentication).
#
# JAVA EQUIVALENT (Spring Security JWT):
#   spring.security.jwt.signing-key=your-base64-encoded-secret
#   or in JwtConfig: @Value("${jwt.secret}") private String secret;
#
# ⚠️ MUST CHANGE IN PRODUCTION! Generate a strong random key:
#   openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Cookie Secret — Secret key for signing HTTP-only session cookies.
# Medusa uses cookies for browser-based authentication (session management).
#
# JAVA EQUIVALENT:
#   server.servlet.session.cookie signing secret (Spring Session)
#
# ⚠️ MUST CHANGE IN PRODUCTION!
COOKIE_SECRET=your-super-secret-cookie-key-change-in-production

# ===========================================
# REDIS CONFIGURATION (Optional)
# ===========================================
# Redis is used for caching, rate limiting, and distributed job queues.
# Not required for local development (Medusa uses in-memory fallbacks).
#
# JAVA EQUIVALENT:
#   spring.data.redis.url=redis://localhost:6379
#   spring.cache.type=redis
#
# Uncomment and configure if you install Redis:
# REDIS_URL=redis://localhost:6379

# ===========================================
# MEDUSA ADMIN
# ===========================================
# Backend URL that the Admin dashboard uses to make API calls.
#
# JAVA EQUIVALENT: The base URL configured in your admin UI's API client.
MEDUSA_ADMIN_BACKEND_URL=http://localhost:9000

# ===========================================
# NODE ENVIRONMENT
# ===========================================
# Tells Medusa whether we're in development or production.
# Affects database logging, error detail level, caching, etc.
#
# JAVA EQUIVALENT:
#   spring.profiles.active=development
#   or: -Dspring.profiles.active=dev
#
# Values: development | production | test
NODE_ENV=development

# ===========================================
# WORKER MODE (Optional)
# ===========================================
# Controls how background jobs (scheduled tasks, email sending, etc.) run.
#
# Values:
#   shared   — Worker and API server in the SAME process (good for dev)
#   worker   — Only background jobs (separate process, like Spring Batch app)
#   server   — Only API server (no background jobs)
#
# JAVA EQUIVALENT:
#   shared   = Single @SpringBootApplication with @EnableScheduling
#   worker   = Separate @SpringBootApplication running only @Scheduled tasks
#   server   = @SpringBootApplication with scheduling disabled
#
# Uncomment to override:
# MEDUSA_WORKER_MODE=shared